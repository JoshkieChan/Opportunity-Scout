# Copy to .env at the repository root. Never commit real credentials.
DISCORD_TOKEN=
CHANNEL_ID_PRIORITY=
CHANNEL_ID_REVIEW=
# Set false only when ready to send Discord alerts.
DRY_RUN=true
RUN_ONCE=false
# Local address; Compose overrides this with the validator service hostname.
VALIDATOR_URL=http://127.0.0.1:8000/validate
HTTP_TIMEOUT_MS=10000
CYCLE_INTERVAL_MS=600000
REQUEST_DELAY_MS=2000
MAX_TARGETS_PER_CYCLE=30
# Optional offline demo, relative to repository root:
# FIXTURE_PATH=fixtures/products.json
